<Window x:Class="Blink.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Blink"
        Title="Blink"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        Cursor="None"
        Background="#F0101418">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="&#128564;"
                       FontSize="72"
                       HorizontalAlignment="Center"
                       Foreground="#5AAAFF"
                       Margin="0,0,0,16" />
            <TextBlock Text="{x:Static l:Strings.Overlay_RestYourEyes}"
                       FontSize="34"
                       FontWeight="Light"
                       HorizontalAlignment="Center"
                       Foreground="#E6EEF6" />
            <TextBlock x:Name="TipText"
                       Text="{x:Static l:Strings.Overlay_Tip}"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Foreground="#8FA3B5"
                       Margin="0,10,0,28" />
            <TextBlock x:Name="CountdownText"
                       Text="60"
                       FontSize="64"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="#E6EEF6" />
            <TextBlock x:Name="SkipHint"
                       Text="{x:Static l:Strings.Overlay_SkipHint}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="#5E7284"
                       Margin="0,28,0,0" />
        </StackPanel>
    </Grid>
</Window>
