<Window x:Class="Blink.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Blink"
        Icon="pack://application:,,,/app.ico"
        Title="{x:Static l:Strings.Settings_Title}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1B2027"
        Foreground="#E6EEF6"
        FontFamily="Segoe UI"
        FontSize="14">
    <Window.Resources>
        <!-- Dark-themed ComboBox to match the settings dialog palette. -->
        <SolidColorBrush x:Key="ComboBackground" Color="#0F141A" />
        <SolidColorBrush x:Key="ComboBackgroundHover" Color="#232C36" />
        <SolidColorBrush x:Key="ComboForeground" Color="#E6EEF6" />
        <SolidColorBrush x:Key="ComboBorder" Color="#3A434E" />
        <SolidColorBrush x:Key="ComboBorderHover" Color="#4A9BEF" />
        <SolidColorBrush x:Key="ComboItemHover" Color="#31404E" />
        <SolidColorBrush x:Key="ComboItemSelected" Color="#2A3A4C" />

        <!-- Toggle button that forms the ComboBox body + arrow. -->
        <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="Bd"
                    Background="{StaticResource ComboBackground}"
                    BorderBrush="{StaticResource ComboBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="22" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow" Grid.Column="1"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="{StaticResource ComboForeground}" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ComboBorderHover}" />
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ComboBackgroundHover}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ComboBorderHover}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource ComboForeground}" />
            <Setter Property="Background" Value="{StaticResource ComboBackground}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboToggleTemplate}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />
                            <ContentPresenter x:Name="ContentSite"
                                              Margin="10,0,26,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource ComboBackground}"
                                        BorderBrush="{StaticResource ComboBorder}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                                        MaxHeight="240"
                                        Margin="0,2,0,0">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource ComboForeground}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBd"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{StaticResource ComboItemHover}" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{StaticResource ComboItemHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{StaticResource ComboItemSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static l:Strings.Settings_BreakEvery}"
                   VerticalAlignment="Center" Margin="0,0,16,12" />
        <l:NumericUpDown x:Name="IntervalBox" Grid.Row="0" Grid.Column="1" Height="28"
                         Minimum="1" Maximum="1440" Increment="1" DecimalPlaces="0"
                         Margin="0,0,0,12" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static l:Strings.Settings_BreakLength}"
                   VerticalAlignment="Center" Margin="0,0,16,12" />
        <l:NumericUpDown x:Name="BreakBox" Grid.Row="1" Grid.Column="1" Height="28"
                         Minimum="5" Maximum="3600" Increment="5" DecimalPlaces="0"
                         Margin="0,0,0,12" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static l:Strings.Settings_Language}"
                   VerticalAlignment="Center" Margin="0,0,16,16" />
        <ComboBox x:Name="LanguageBox" Grid.Row="2" Grid.Column="1" Height="28"
                  VerticalContentAlignment="Center" Margin="0,0,0,16" />

        <CheckBox x:Name="AllowSkipBox" Grid.Row="3" Grid.ColumnSpan="2"
                  Content="{x:Static l:Strings.Settings_AllowSkip}"
                  Foreground="#E6EEF6" Margin="0,4,0,4" />

        <CheckBox x:Name="StartEnabledBox" Grid.Row="4" Grid.ColumnSpan="2"
                  Content="{x:Static l:Strings.Settings_StartScheduling}"
                  Foreground="#E6EEF6" Margin="0,4,0,4" />

        <CheckBox x:Name="StartWithWindowsBox" Grid.Row="5" Grid.ColumnSpan="2"
                  Content="{x:Static l:Strings.Settings_StartWithWindows}"
                  Foreground="#E6EEF6" Margin="0,4,0,16" />

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="{x:Static l:Strings.Settings_OK}" Width="88" Height="30"
                    Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="{x:Static l:Strings.Settings_Cancel}" Width="88" Height="30"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
