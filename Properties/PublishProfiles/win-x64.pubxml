<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained, single-file publish profile for Blink.
  Produces one Blink.exe with the .NET runtime bundled (no install needed on
  the target machine). Localized fr/es satellite assemblies are embedded too.

  Publish from the CLI:
      dotnet publish -p:PublishProfile=win-x64

  Or in Visual Studio: right-click the project > Publish > win-x64.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <PublishDir>bin\Release\publish\win-x64\</PublishDir>

    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <!-- One file, runtime bundled, compressed. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- ReadyToRun (precompiled native code) is off: it roughly halves the file
         size in exchange for a marginally slower cold start. -->
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- Ship just Blink.exe: no .pdb debug symbols. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
