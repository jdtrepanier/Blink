<Window x:Class="Blink.BreakWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Blink"
        Title="Blink"
        Width="300"
        Height="118"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Transparent"
        FontFamily="Segoe UI">
    <Border Background="#F0101418" BorderBrush="#3A434E" BorderThickness="1" CornerRadius="10"
            MouseLeftButtonDown="OnBackgroundClick">
        <Grid Margin="18,14,18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image x:Name="AppIcon"
                   Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                   Width="28" Height="28"
                   VerticalAlignment="Top"
                   Margin="0,1,12,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{x:Static l:Strings.Balloon_BreakSoonTitle}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#E6EEF6" />
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{x:Static l:Strings.Balloon_BreakSoonMessage}"
                       FontSize="13"
                       Foreground="#8FA3B5"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
            <Button x:Name="SkipButton"
                    Grid.Row="2" Grid.Column="1"
                    Content="{x:Static l:Strings.BreakWarning_SkipButton}"
                    Click="OnSkipClick"
                    HorizontalAlignment="Right"
                    Width="88"
                    Height="28"
                    Margin="0,12,0,0" />
        </Grid>
    </Border>
</Window>
